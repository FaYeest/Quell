# ==============================================================================
# Quell Autonomous AI Security Engineer SaaS - Environment Variables
# ==============================================================================

# Server & Networking
PORT=8080
ENV=development # development | production

# PostgreSQL Database (with pgvector extension)
DATABASE_URL=postgres://quell:quellpassword@localhost:5433/quell_db?sslmode=disable

# Redis Task Queue (Asynq)
REDIS_URL=localhost:6379
WORKER_CONCURRENCY=5

# GitHub App Integration
# Obtained from GitHub App Settings (https://github.com/settings/apps/<your-app>)
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY_PATH=/path/to/quell-app.private-key.pem
# Alternatively, provide raw PEM string or base64-encoded string:
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n..."
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# AI / LLM Orchestration (OpenAI / Anthropic / Gemini / DeepSeek / Ollama)
# If empty, Quell uses embedded deterministic triage rules for offline development
OPENAI_API_KEY=sk-proj-your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini # or gpt-4o, claude-3-5-sonnet, gemini-2.5-flash
